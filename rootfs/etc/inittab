# AginxOS rootfs inittab — busybox init as PID 1 after switch_root.
# Our console is the ffs.adb gadget (adbd), not a serial tty.
::sysinit:/etc/init.d/rcS
# aginxos-init kills the trampoline's adbd before the switch, so this
# respawn is what brings the console back (~12s to re-enumerate).
::respawn:/etc/init.d/adbd
# Service supervisor (M16 agsvc, N4③b 改姓 aginx-svcd) — owns every
# non-console daemon (units in /etc/aginx/svc.d + /var/lib/aginx/units;
# control via aginx-svc). busybox respawns aginx-svcd if it dies; its
# children carry PDEATHSIG so they go down with it — no double-spawn
# window. Lives in /usr/libexec/aginx/ (out of the router's command
# scan, D13: libexec 是引擎的家).
::respawn:/usr/libexec/aginx/aginx-svcd
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/sync
::restart:/sbin/init
