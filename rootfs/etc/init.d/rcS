#!/bin/sh
# AginxOS rcS - one-shot setup, runs before the respawns in inittab.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/system/bin

# Fill in the full applet set (image ships only a curated symlink list),
# then populate /dev from sysfs — nothing udevs in our world, so input event
# nodes and friends only exist after mdev runs.
/bin/busybox --install -s /bin 2>/dev/null
mdev -s 2>/dev/null

# M22: restore state captured before a rootfs swap (no-op on normal
# boots; must run before chown and before any service needs /home,
# /etc/wifi.conf or /var).
/etc/init.d/state-restore

# N5③: the state tar from the first-gen updater carries the OLD /var/lib
# names — fold them into /var/lib/aginx before anything reads state.
# Union + park, never deletes; no-op once the world is folded.
/etc/init.d/varlib-migrate

# First-boot root-fs grow (#318, L0 缺口刀1) — SYNCHRONOUS, deliberately
# before everything that writes big: the image bakes a 2G ext4 onto the
# 109G userdata partition and every re-flash reverts to 2G. resize2fs
# reads the partition geometry itself and no-ops when already grown, so
# this runs every boot (the artifact is the truth: df — no markers, per
# M27 discipline). Synchronous because provision's sync pulls ~239MB of
# packages into / and racing that against a 2G fs is the M12 curse; the
# live grow itself took 0.45 s. Always exits 0 — never blocks a boot.
/etc/init.d/disk-grow

# Host mke2fs -d stored the macOS build user (uid 501) as owner - the
# filesystem is rw, so the first boot normalizes it for good.
chown -R 0:0 /bin /sbin /etc /aginxos /system /home /root /var /opt /srv /media 2>/dev/null
chown 0:0 /default.prop /prop.default /*_contexts 2>/dev/null

# /proc, /sys and /dev were carried in by aginxos-init before chroot;
# these only run if something is missing (idempotent).
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null

hostname aginxos
ifconfig lo 127.0.0.1 netmask 255.0.0.0 up 2>/dev/null

# cpufreq (M42e) — qcom-cpufreq-hw 不加载时两组核心都停在 RPMh 遗留的低频
# （A76 钉核 TTS 22.9s；驱动加载升频后同句 8.7s，收据 HARDWARE.md M42e）。
# 越早加载越好：下面所有 bring-up 脚本都吃满频。governor 用 schedutil——
# 负载升频、空闲落回 300MHz，性能与 performance 无差而待机不烧。
if [ -e /vendor_a/lib/modules/qcom-cpufreq-hw.ko ]; then
  insmod /vendor_a/lib/modules/qcom-cpufreq-hw.ko 2>/dev/null
  for P in /sys/devices/system/cpu/cpufreq/policy*; do
    echo schedutil > "$P/scaling_governor" 2>/dev/null
  done
fi

# Cross-boot forensics: the kernel has no pstore, so a death (PMIC power cut
# vs kernel hang) leaves evidence only if something was already writing it
# to the ext4 /var. The 2026-08-27 morning deaths were diagnosed as UVLO
# power cuts exactly because a kmsg follower was running (last line:
# "PMIC input: code=116"). Heartbeat stamps uptime every 5s — where it
# stops vs when USB died discriminates hang-vs-power on the next death.
# Bounded: 387 MB of kmsg filled the 2 GB rootfs on 2026-09-01 (adb push
# ENOSPC). head -c caps each file at 32 MB (cat dies on SIGPIPE), the
# loop rotates to .old — the record is always the most recent ~64 MB.
(while :; do
  mv -f /var/kmsg-follow.log /var/kmsg-follow.old 2>/dev/null
  cat /dev/kmsg 2>/dev/null | head -c 33554432 > /var/kmsg-follow.log
  sleep 5
done) &
(while :; do
  echo "$(date +%H%M%S) up=$(cut -d. -f1 /proc/uptime)" >> /var/heartbeat.log
  sleep 5
done) &

echo "aginxos: rcS done, rootfs up on userdata" > /dev/kmsg
date > /etc/.rcs-ran

# Boot card (M5 → 开机剧情 v4⑤ #246) — the panel UI: the AginxOS wordmark
# where the Google splash sat. Exits on boot.state's `done` verdict (#282:
# ok holds 3 s, fail 8 s grace, 150 s hard deadline) — the story continues
# on the panel in aginx-term/aginx-voice. Starts FIRST because it must own
# DRM master as soon as the panel registers (it retries until then —
# msm_drm + panel take ~60 s, loaded by touch-bringup below). Dropping
# master at exit blanks the panel via dsi_backlight's dpms hooks — that
# beat of black is the handoff; term relights it.
mkdir -p /run 2>/dev/null
: > /run/boot.state
( exec /bin/bootcard /run/boot.state ) >/var/bootcard.log 2>&1 &
# aginx-term-handoff (#246 v2) does not wait for bootcard — it spawns
# aginx-term right away and term's DRM wait covers the rest. The log/pid
# files have no in-repo reader; they are flash-day forensics.
echo $! > /run/bootcard.pid

# Touch bring-up (M3) — backgrounded: it waits out the ~60s panel
# registration, and the console must not block on it. Loads the display
# chain and reports touch ok/fail into /run/boot.state.
/etc/init.d/touch-bringup &

# Battery bring-up (M3c) — backgrounded: google-battery keeps retrying
# until the psy appears, so this script just feeds modules and waits.
/etc/init.d/battery-bringup &

# Radio bring-up (M3d) — backgrounded: stands up the QRTR service stack,
# boots the modem (its own watchdog kills it in 65 s without the services)
# and loads the WLAN driver. Ordering vs touch-bringup is race-tolerant:
# both chains re-insmod with 2>/dev/null.
/etc/init.d/radio-bringup &

# Audio bring-up (M18) — backgrounded: waits for radio-bringup's ADSP ONLINE
# + "Q6 is Up" (apr's of_platform_populate creating the sound subtree), then
# loads the codec chain in dependency order and reports into boot.state.
/etc/init.d/audio-bringup &

# Camera bring-up (M19) — backgrounded: loads the Qualcomm cam_req_mgr
# stack for the IFE route. cam_req_mgr_late must be the LAST module (it
# seals the subdev registry); camera-bringup encodes that order.
/etc/init.d/camera-bringup &

# Network bring-up (M5 → #246 phase split) — backgrounded: phase 1 waits
# for wlan0 from radio-bringup plus the sibling local verdicts, then
# writes `done` (the boot verdict no longer waits for the net); phase 2
# joins /etc/wifi.conf, DHCP, fetches http://www.baidu.com, syncs the
# clock — every step lands in /run/boot.state, and net failures self-heal
# (net-watch) without ever marking the boot failed.
/etc/init.d/net-bringup &

# First-boot provisioning (M10) — waits for net-bringup's internet verdict,
# then aginx-pkg syncs the required-tier manifest. Also the self-heal path: a
# missing/corrupt /var/bin binary is re-downloaded on the next networked
# boot. Backgrounded; a no-op when the manifest has no active entries.
/etc/init.d/provision &

# Service layer (M16 agsvc → N4 aginx-svcd) — inittab respawns
# /usr/libexec/aginx/aginx-svcd once rcS finishes, which starts units
# from /etc/aginx/svc.d (L0: net-watch + aginxbrowser only — absent-
# tolerant browser face) plus /var/lib/aginx/units (units that ride
# their packages: aginx, aginx-secretd, aginx-gateway, aginx-voice …),
# restarts them on crash with backoff, and re-checks absent binaries
# every 30 s so an install lands without a reboot. Control: aginx-svc
# list|status|start|stop|restart|reload over /run/aginx-svc/ctl.sock.

# crond — busybox crond reads /etc/crontabs/root. N5④: the #86 daily
# backup line is BACK on the new local line (aginx-backup v2 — state
# world snapshot, no carrier.db in this world).
# -c pins the dir (busybox defaults to /var/spool/cron/crontabs which
# we don't create). Log at /var/log/crond.log.
mkdir -p /var/log
if [ -x /bin/crond ]; then
  /bin/crond -b -c /etc/crontabs -L /var/log/crond.log
fi

# Ops channel sshd (#142) — the maintenance face: ssh in over Wi-Fi, or
# `adb forward tcp:2222 tcp:22` when the dev box sits on another subnet.
# Both channels open: pubkey (push yours to /root/.ssh/authorized_keys)
# and password (set with `echo root:… | busybox chpasswd -c sha512` —
# #320: bare chpasswd/passwd write des crypt, 8-char truncated). Until
# a password is set, the seeded /etc/shadow keeps root's hash `*` —
# every password compare fails, so the password lane is
# inert-by-default. Host key lives under
# /root/.ssh so the state tar carries it across system updates (first
# boot generates it). -E logs to stderr (no syslogd here) →
# /var/log/dropbear.log.
mkdir -p /root/.ssh
if [ -x /bin/dropbear ]; then
  [ -f /root/.ssh/dropbear_ed25519_host_key ] || \
    /bin/dropbearkey -t ed25519 -f /root/.ssh/dropbear_ed25519_host_key >/dev/null 2>&1
  /bin/dropbear -p 22 -r /root/.ssh/dropbear_ed25519_host_key -E \
    >>/var/log/dropbear.log 2>&1
fi

# Boot-successful marker (M16) — ABL drains the GPT slot-retry attribute
# on every unmarked boot and the phone ends up in fastboot (or falls
# through to slot b's stock bootloader, which would format our userdata).
# Wait for boot.state's final verdict (net-bringup writes it), then flag
# the active slot successful in every LUN's GPT.
( n=0
  while [ $n -lt 150 ]; do
    grep -q '^done ok' /run/boot.state 2>/dev/null && break
    sleep 2; n=$((n+1))
  done
  /usr/bin/aginx-boot-ok ) &

# Panel handoff (M11 → #246 v2) — spawns aginx-term (cursor face)
# immediately; term's own DRM wait covers bootcard's time on stage.
/etc/init.d/aginx-term-handoff &
