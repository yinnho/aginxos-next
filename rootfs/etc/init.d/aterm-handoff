#!/bin/sh
# Panel handoff (M11): bootcard -> aginx-term (N4③b 原名 aterm；脚本名
# aterm-handoff 保留——它是 init.d 的服务面，不是命令).
#
# bootcard never exits on its own — dropping DRM master lets dsi_backlight's
# dpms hooks blank the panel. So once boot finishes (a "done ok|fail" line
# lands in /run/boot.state, or a hard 5 min timeout for broken boots), we
# kill bootcard and start aginx-term. It re-takes master and paints its first
# frame before SETCRTC, so the panel only dips for the modeset itself.
# The respawn loop keeps the UI alive if aginx-term ever crashes.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
# M17 voice hook: watch /run/aterm.inject (ASR text lands there; aterm
# types it into the pty). Was hand-exported since M18 — baked here in
# #13 so it survives rootfs swaps.
export ATERM_INJECT=1

n=0
while ! grep -q '^done ' /run/boot.state 2>/dev/null && [ $n -lt 150 ]; do
  sleep 2; n=$((n+1))
done
# let the operator see the final boot card for a moment
sleep 5

[ -f /run/bootcard.pid ] && kill "$(cat /run/bootcard.pid)" 2>/dev/null
# belt and braces: if the pidfile was lost, kill by name
pidof bootcard >/dev/null 2>&1 && kill $(pidof bootcard) 2>/dev/null
sleep 1

( while :; do
    echo "=== aginx-term start $(date) ===" >> /var/aterm.log
    /usr/bin/aginx-term >> /var/aterm.log 2>&1
    sleep 2
  done ) &
