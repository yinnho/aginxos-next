{
  "env": {
    "AGINXBRAIN_API_KEY": "brain.primary"
  },
  "allow": {
    "brain.primary": ["/usr/libexec/aginx/aginx-server", "/var/bin/aginx-server", "/var/lib/aginx/pkgfiles/aginx/bin/aginx-server"],
    "relay.primary": ["/usr/libexec/aginx/aginx-gateway", "/var/bin/aginx-gateway"],
    "admin": ["/usr/bin/aginx-secret"]
  }
}
