# aginx groups.desc — group key = one-line menu description (D13).
# File-is-registry: a package introduces a new group by appending a line
# here, no router reflash. Read by `aginx` at menu time;
# AGINX_GROUPS_DESC overrides for tests and the build-time --check gate.
cam=camera capture, QR and OCR
snd=audio capture, playback, mixer
net=wi-fi scan, join, self-heal
sys=system status, reboot, provision markers
pkg=package install and sync
svc=supervised service units
agent=agent conversation and session faces
web=browser, search and fetch tools (in-mother aginxbrowser client)
files=file read/write/list/convert tools (aginx-file package)
mem=memory tools: kv, tree, knowledge, flows (aginx-mem package)
sec=secret store admin: set, get, rm, list, sign (aginx-secretd sidecar)
backup=local state backup: snapshot, list, verify, retention
