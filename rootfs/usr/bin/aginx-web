#!/bin/sh
# aginx:summary=browser, search and fetch tools: navigate/read/click pages, web search, fetch URLs
# aginx:group=web
# aginx:args=<subcommand> [args…]
# aginx:examples=fetch https://example.com
# aginx:examples=search oranges
# N4 bridge shell to the provisioned tool package. The package itself is
# re-cut under the same aginx-web name (D13 rename, was first-gen `agb`).
# No aginx:exec — the target only exists after the first provision sync
# (bake-time lint would fail on it). Post-provision this shim is shadowed
# by /var/bin/aginx-web + its .aginxmd sidecar (same route `web`, same
# summary — keep the two in lockstep).
exec /var/bin/aginx-web "$@"
